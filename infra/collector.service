# §9.5 / §10 — systemd unit for the Stockbit market-data collector.
#
# This file is the canonical unit definition, committed to the repo as a
# reference. The copy actually deployed to EC2 is generated by user_data.sh.tftpl
# (which interpolates the runtime environment variables from TF template vars).
#
# KillSignal=SIGTERM + TimeoutStopSec=120: on EventBridge scheduled stop the
# collector receives SIGTERM and has 120s to flush the open segment, compress
# it (zstd), write the manifest, and upload to S3 before systemd force-kills it.
# 120s is generous — even a full-day segment compresses in a few seconds and
# S3 upload of ~35 MB over a Jakarta-region link takes well under a minute.

[Unit]
Description=Stockbit market-data collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=collector
Group=collector

# Pull the latest binary from S3 before each start (runs every boot).
ExecStartPre=/opt/collector/update.sh
ExecStart=/opt/collector/collector
Restart=on-failure
RestartSec=5s

# Clean segment flush on EventBridge scheduled stop (§9.5)
KillSignal=SIGTERM
TimeoutStopSec=120

# Runtime environment — these values are placeholders; the deployed unit
# (written by user_data.sh.tftpl) has the real values injected by TF.
Environment="CAPTURE_DIR=/var/lib/collector/segments"
Environment="CAPTURE_WATCHLIST_ID=default"
Environment="CAPTURE_WATCHLIST=BBCA,BMRI,TLKM,ASII,BBRI"
Environment="SSM_PARAM_PREFIX=/sb-collector"
Environment="S3_BUCKET=marketdata-<account-id>"
Environment="AWS_REGION=ap-southeast-3"

# Journal logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=collector

[Install]
WantedBy=multi-user.target
