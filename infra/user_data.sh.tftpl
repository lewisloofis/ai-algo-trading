#!/bin/bash
# cloud-init user_data — installs the collector systemd service.
# §9.5 / §10 / §12.3
#
# Unlike a one-shot first-boot fetch, the binary is pulled from S3 on EVERY boot
# via an ExecStartPre updater (see /opt/collector/update.sh below). Because the
# EventBridge schedulers stop/start (never re-launch) the instance, this makes
# binary updates a one-line `aws s3 cp` to the artifact key: the next scheduled
# start picks up the latest binary automatically.
#
# Template variables (injected by ec2.tf templatefile()):
#   watchlist_id              — e.g. "default"
#   watchlist                 — comma-separated symbols, e.g. "BBCA,BMRI,TLKM,ASII,BBRI"
#   ssm_prefix                — "/sb-collector"
#   s3_bucket                 — bucket name
#   region                    — AWS region, e.g. "ap-southeast-3"
#   collector_artifact_s3_uri — S3 URI for the arm64 binary (e.g. s3://<bucket>/artifacts/collector)

set -euo pipefail

# --- Create dedicated user and working directories ----------------------------
useradd --system --no-create-home --shell /sbin/nologin collector || true
install -d -o collector -g collector -m 750 /opt/collector
install -d -o collector -g collector -m 750 /var/lib/collector/segments

# --- Write the boot-time updater script ---------------------------------------
# Pulls the latest binary from S3 before each start. On fetch failure it falls
# back to the last-known-good binary so a transient S3/network blip does not stop
# an already-deployed collector. A first boot with no binary in S3 yet fails fast
# and systemd retries (Restart=on-failure).
cat > /opt/collector/update.sh << 'UPDATE'
#!/bin/bash
set -euo pipefail

ARTIFACT_URI="${collector_artifact_s3_uri}"
REGION="${region}"
DEST=/opt/collector/collector

if [ -z "$ARTIFACT_URI" ]; then
  # No artifact configured — rely on a manually-placed binary if present.
  [ -x "$DEST" ] && exit 0
  echo "update: no collector_artifact_s3_uri set and no binary at $DEST" >&2
  exit 1
fi

TMP="$(mktemp /opt/collector/collector.XXXXXX)"
if aws s3 cp "$ARTIFACT_URI" "$TMP" --region "$REGION"; then
  chmod 0755 "$TMP"
  mv -f "$TMP" "$DEST"
  echo "update: fetched latest collector from $ARTIFACT_URI"
  exit 0
fi

rm -f "$TMP"
if [ -x "$DEST" ]; then
  echo "update: S3 fetch failed; using existing binary at $DEST" >&2
  exit 0
fi
echo "update: S3 fetch failed and no existing binary at $DEST" >&2
exit 1
UPDATE
chmod 0755 /opt/collector/update.sh
chown collector:collector /opt/collector/update.sh

# --- Write the systemd unit ---------------------------------------------------
# ExecStartPre pulls the latest binary on every start. KillSignal=SIGTERM +
# TimeoutStopSec=120 ensures the open segment is flushed, compressed, and
# uploaded to S3 before the EventBridge stop terminates the instance (§9.5).
cat > /etc/systemd/system/collector.service << 'UNIT'
[Unit]
Description=Stockbit market-data collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=collector
Group=collector

# Pull the latest binary from S3 before each start (runs every boot).
ExecStartPre=/opt/collector/update.sh
ExecStart=/opt/collector/collector
Restart=on-failure
RestartSec=5s

# Clean segment flush on EventBridge scheduled stop (§9.5)
KillSignal=SIGTERM
TimeoutStopSec=120

# Runtime environment — matches the env vars the Go collector reads.
Environment="CAPTURE_DIR=/var/lib/collector/segments"
Environment="CAPTURE_WATCHLIST_ID=${watchlist_id}"
Environment="CAPTURE_WATCHLIST=${watchlist}"
Environment="SSM_PARAM_PREFIX=${ssm_prefix}"
Environment="S3_BUCKET=${s3_bucket}"
Environment="AWS_REGION=${region}"

# Journal logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=collector

[Install]
WantedBy=multi-user.target
UNIT

# --- Eligibility snapshot (plan 18 A-3) ---------------------------------------
# Records which symbols were fundable TODAY. The emitten endpoints report only
# current eligibility -- no history, effective_date is null -- so the
# point-in-time universe cannot be reconstructed, only accrued going forward.
# Every session without a snapshot is permanently missing.
#
# Fired once per boot rather than on a timer: EventBridge starts this instance
# at 08:30 on weekdays only, so boot-triggered IS one snapshot per trading day,
# taken pre-open. No timer to drift, nothing to run on a holiday.
#
# Deliberately decoupled from collector.service. A failed snapshot must never
# stop capture (order book cannot be backfilled), and a failed capture must not
# stop the snapshot.
install -d -o collector -g collector -m 750 /opt/universe

cat > /opt/universe/run.sh << 'SNAP'
#!/bin/bash
set -euo pipefail

ARTIFACT="s3://${s3_bucket}/artifacts/universe-snapshot.pyz"
REGION="${region}"
DEST=/opt/universe/universe-snapshot.pyz

# Refresh the artifact each boot, same contract as the collector binary: a
# publish to the artifacts key is picked up by the next scheduled start. Falls
# back to the last-known-good copy so an S3 blip does not cost a session.
TMP="$(mktemp /opt/universe/snap.XXXXXX)"
if aws s3 cp "$ARTIFACT" "$TMP" --region "$REGION"; then
  chmod 0755 "$TMP"
  mv -f "$TMP" "$DEST"
else
  rm -f "$TMP"
  [ -f "$DEST" ] || { echo "snapshot: no artifact and no cached copy" >&2; exit 1; }
  echo "snapshot: S3 fetch failed; using cached $DEST" >&2
fi

# No SB_BEARER_TOKEN here: the token is read from $SSM_PARAM_PREFIX/access,
# which the collector rotates. Read-only -- it never touches /refresh, because
# minting a token would rotate the refresh token and invalidate the collector's
# own session mid-capture.
exec python3 "$DEST" --bucket "${s3_bucket}" --region "$REGION" --ssm-prefix "${ssm_prefix}"
SNAP
chmod 0755 /opt/universe/run.sh
chown collector:collector /opt/universe/run.sh

cat > /etc/systemd/system/universe-snapshot.service << 'SNAPUNIT'
[Unit]
Description=Record today's fundable universe (plan 18 A-3)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=collector
Group=collector
ExecStart=/opt/universe/run.sh
RemainAfterExit=no

# One retry: the box boots at 08:30 and a transient API or S3 failure would
# otherwise cost a day that cannot be re-recorded.
Restart=on-failure
RestartSec=60s
StartLimitBurst=2

Environment="AWS_REGION=${region}"
Environment="SSM_PARAM_PREFIX=${ssm_prefix}"

StandardOutput=journal
StandardError=journal
SyslogIdentifier=universe-snapshot

[Install]
WantedBy=multi-user.target
SNAPUNIT

# --- Enable and start the services --------------------------------------------
systemctl daemon-reload
systemctl enable --now collector.service
systemctl enable --now universe-snapshot.service
