# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------

# Compiled command binaries (rebuildable via `make build`).
/bin/

# Captured market-data segments (never commit).
/segments/
*.binpb
*.binpb.zst
*.manifest.json

# Live-bot run records: post-trade stores plus pre/post account snapshots that carry the
# trading account number. The dashboard reads them; they are never committed.
/runs

# Token store (treat like a password — never commit).
.sb-tokens.json

# Local environment overrides: AWS creds, SB_BEARER_TOKEN (never commit).
.env.local
.env.*.local

# Stockbit production source — local reference clones only, NEVER commit.
/sb-android/
/sb-ios/
/sb-protos/
/sb-web/

# Study/analysis outputs (regenerable from segments).
out/
*.png

# Derived research data (regenerable from S3 segments or API pulls).
# `/*` (not a bare directory match) so the negations below can still
# un-ignore specific files — git cannot re-include a file whose parent
# directory pattern excluded the directory itself.
research/data/*
# ...except the extraction script and its tests — source, not derived data.
!research/data/extract_survivors.sh
!research/data/test_extract_survivors.py

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------

# Test binaries and profiling output.
*.test
*.out
*.prof

# Compiled Go binaries (e.g. collector/bin/authprobe).
collector/bin/

# Coverage.
coverage.txt
coverage.html


# Dependency vendor dir (uncomment if not vendoring).
# vendor/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------

# Byte-compiled / optimized.
__pycache__/
*.py[cod]
*$py.class

# Virtual environments.
.venv/
venv/
env/
ENV/

# Packaging / build.
build/
dist/
*.egg-info/
.eggs/
*.egg

# Test / coverage / type-check caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Jupyter.
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp
*~
tools/universe-snapshot.pyz
research/out_cost_report/
